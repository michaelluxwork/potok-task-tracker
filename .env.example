# Template only. The app reads environment variables; it does not load this file.
# Railway upload/account/public launch has not been performed.
TRACKER_PUBLIC=1
TRACKER_STATE_DIR=/data
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS_LONG
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_PUBLIC_HOSTNAME
DJANGO_CSRF_TRUSTED_ORIGINS=https://REPLACE_WITH_PUBLIC_HOSTNAME
# Set only after verifying the reverse proxy boundary; never assume wildcard trust.
TRACKER_TRUSTED_PROXY=REPLACE_WITH_VERIFIED_PROXY_IP
# Leave unset until deployment-specific controls and user approval are complete.
# TRACKER_PUBLIC_RELEASE_APPROVED=1

# VPS behind nginx: explicit loopback and small worker budget.
TRACKER_BIND_HOST=127.0.0.1
TRACKER_THREADS=2
